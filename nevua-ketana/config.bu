variant: fcos
version: 1.7.0

passwd:
  users:
    - name: keelan
      groups:
        - wheel
        - sudo
      # Values come from the gitignored secrets.env next to this file;
      # butane.sh substitutes them in before transpiling.
      password_hash: ${USER_PASSWORD_HASH}
      ssh_authorized_keys:
        - ${USER_SSH_PUBLIC_KEY}

storage:

  directories:
    - path: /etc/ucore-autorebase
      mode: 0755
    - path: /var/mnt/storage
      mode: 0755

  # No `disks:` section: the two data disks are wiped by setup-storage.sh (step 1
  # of the script), which also builds the volume. Keeping the wiping and the
  # setup in one file means one place to read and one place to test.

  files:
    # --- Shared: keelan's tmux config ---
    - path: /home/keelan/.tmux.conf
      mode: 0644
      overwrite: true
      contents:
        local: shared/.tmux.conf

    # --- Shared: keelan's neovim config ---
    - path: /home/keelan/.config/nvim/init.lua
      mode: 0644
      overwrite: true
      contents:
        local: shared/init.lua

    # Machine-specific: hostname (nevua-ketana)
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: nevua-ketana

    # Machine-specific: WoL helper (nevua-ketana)
    - path: /usr/local/bin/wol-enable.sh
      mode: 0755
      overwrite: true
      contents:
        inline: |
          #!/bin/bash
          set -euo pipefail
          IFACE="enp14s0"
          echo "Enabling Wake-on-LAN on $IFACE..."
          ethtool -s "$IFACE" wol g
          ethtool "$IFACE" | grep -i "wake-on"

    # --- Machine-specific: storage provisioning script (nevua-ketana) ---
    # /usr/local is a symlink to /var/usrlocal on CoreOS, so this path is
    # writable and survives image upgrades/rebases. Only written here; it is
    # executed once by setup-storage.service (see systemd.units below).
    - path: /usr/local/bin/setup-storage.sh
      mode: 0755
      overwrite: true
      contents:
        local: nevua-ketana/setup-storage.sh

    # --- Machine-specific: model fetch script (nevua-ketana) ---
    - path: /usr/local/bin/fetch-models.sh
      mode: 0755
      overwrite: true
      contents:
        local: nevua-ketana/fetch-models.sh

    # --- Kill switch (nevua-ketana) ---
    # If this file exists at first boot, setup-storage.sh and fetch-models.sh
    # skip their work (no wipe, no fetch) and write their done markers as if
    # they had run, so the chain continues against whatever is already on the
    # data disks: var-mnt-storage.mount mounts the existing volume and
    # llama-server.service starts against the existing model tree. An install
    # that preserves the existing volume and models instead of recreating
    # them. Comment this entry out (and rebuild) for a fresh install that
    # formats and fetches. fetch-models.sh removes the file once consumed, so
    # it never survives on the box.
    - path: /var/lib/provision.lock
      mode: 0644
      overwrite: true
      contents:
        inline: 'kill switch: skip storage setup and model fetch'

    # --- llama.cpp server: Podman quadlet ---
    # The router's --models-preset INI is deliberately not seeded here: it lives
    # in the model tree and arrives with fetch-models.sh, so nothing under /etc
    # has to point at a volume that does not exist yet on the first boot.
    # Pull-on-boot: the quadlet carries Pull=always, so every start re-resolves
    # the server-cuda13 tag and the box runs the newest llama.cpp build.
    - path: /etc/containers/systemd/llama-server.container
      mode: 0644
      overwrite: true
      contents:
        local: nevua-ketana/llama-server.container

    # --- llama.cpp server: firewalld rule for port 8001 ---
    # NOTE: plain .service file, so it must live in /etc/systemd/system
    # (systemd's unit search path). /etc/containers/systemd is only scanned
    # by the podman quadlet generator for quadlet files.
    - path: /etc/systemd/system/llama-server-firewall.service
      mode: 0644
      overwrite: true
      contents:
        local: nevua-ketana/llama-server-firewall.service

systemd:
  units:

    # --- Generic: uCore autorebase chain ---
    # Runs across 2 boots: unsigned rebase → reboot → signed rebase → reboot
    # After both complete, these units are disabled and never run again.

    - name: ucore-unsigned-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to unsigned OCI and reboot
        ConditionPathExists=!/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/ublue-os/ucore-minimal:stable-nvidia
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/unverified
        ExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    - name: ucore-signed-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to signed OCI and reboot
        ConditionPathExists=/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-image-signed:docker://ghcr.io/ublue-os/ucore-minimal:stable-nvidia
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/signed
        ExecStart=/usr/bin/systemctl disable ucore-signed-autorebase.service
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    # --- Generic: package installation ---
    # Waits for signed rebase to complete (avoids race condition).
    # Reboots once after installing, then disables itself.

    - name: install-user-packages.service
      enabled: true
      contents: |
        [Unit]
        Description=Install user packages via rpm-ostree
        ConditionPathExists=/etc/ucore-autorebase/signed
        ConditionPathExists=!/var/lib/install-user-packages.done
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree install neovim tmux tree btop
        ExecStart=/usr/bin/touch /var/lib/install-user-packages.done
        ExecStart=/usr/bin/systemctl disable install-user-packages.service
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    # --- Machine-specific: LVM cached storage volume (nevua-ketana) ---
    # Boot 4: builds vg_storage (20 TB HDD origin cached by the 1 TB NVMe) and
    # formats it XFS. DESTRUCTIVE to both data disks - the script wipes them
    # (wipefs) as its first step, so it needs nothing from Ignition.
    # Gated on install-user-packages' done marker because that unit disables
    # itself on an earlier boot, so After= alone would not order us behind it
    # (see "Why this ordering matters" in the README). On failure the marker
    # is not written - a oneshot stops at the first failed ExecStart - so the
    # whole thing retries on the next boot.
    # The mount-unit ExecStart gives us a mounted volume on the *same* boot
    # that created it: var-mnt-storage.mount is pulled in by multi-user.target
    # before this service runs, so its condition gate is evaluated (and fails,
    # no marker yet) and the job is already done by the time the marker exists.
    # Starting it again after the touch re-queues the job and mounts it.

    - name: setup-storage.service
      enabled: true
      contents: |
        [Unit]
        Description=Create the LVM cached storage volume (one-shot)
        ConditionPathExists=/var/lib/install-user-packages.done
        ConditionPathExists=!/var/lib/setup-storage.done
        After=install-user-packages.service

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        ExecStart=/usr/local/bin/setup-storage.sh
        ExecStart=/usr/bin/touch /var/lib/setup-storage.done
        ExecStart=/usr/bin/systemctl --no-block start var-mnt-storage.mount
        ExecStart=/usr/bin/systemctl disable setup-storage.service

        [Install]
        WantedBy=multi-user.target

    # --- Machine-specific: mount the cached storage volume (nevua-ketana) ---
    # Native systemd mount unit, not /etc/fstab: FCOS ships no fstab and
    # mutating one at runtime is an anti-pattern on immutable images. The unit
    # name must be the escaped mount point (slashes -> dashes, `systemd-escape
    # --path`), i.e. /var/mnt/storage -> var-mnt-storage.mount. No \x2d here
    # because the path itself contains no dashes.
    # Gate: ConditionPathExists on setup-storage.service's done marker
    # (/var/lib/setup-storage.done) is what
    # keeps the mount from ever being attempted before the volume exists. A
    # condition is evaluated when the job starts, so a pre-setup boot skips the
    # unit in milliseconds instead of sitting in the 90s implicit device wait
    # for /dev/vg_storage/lv_data. After the marker exists, the implicit
    # Requires=/After= on dev-vg_storage-lv_data.device does the real waiting
    # for LVM to activate (and activate the cache of) the LV.
    # nofail has no effect on mount(8) itself (libmount swallows it, it never
    # reaches the kernel) but it does have a systemd one: mount_is_nofail()
    # drops the automatic Before=local-fs.target ordering, so a missing or
    # degraded volume can never stall the local-fs phase. With no ordering
    # against local-fs.target the unit belongs in the multi-user phase, which
    # only Wants= it - a failed mount is a failed unit, not a hung boot.
    # enabled: true requires the [Install] section (butane --strict warns if a
    # unit is enabled without one), and it is genuinely needed: systemd >= v257
    # no longer injects local-fs.target Wants=<mount>, so nothing would pull a
    # mount unit in on its own.
    # NOTE: x-systemd.device-timeout= / x-systemd.mount-timeout= are fstab-only
    # and are explicitly ignored in a unit's Options= (systemd.mount(5)), so they
    # are absent below.
    # llama-server.container depends on this unit via RequiresMountsFor=, so the
    # container cannot start against an unmounted (empty) /var/mnt/storage.
    # No ownership here on purpose: who may write the volume is a property of
    # the filesystem (its root inode), set once by setup-storage.sh. The 0755
    # root:root directory below is only the *mount point* — it is hidden by the
    # volume the moment the mount lands, and its mode says nothing about access
    # to the data.

    - name: var-mnt-storage.mount
      enabled: true
      contents: |
        [Unit]
        Description=Cached storage volume (vg_storage/lv_data) at /var/mnt/storage
        Documentation=file:///usr/local/bin/setup-storage.sh
        ConditionPathExists=/var/lib/setup-storage.done

        [Mount]
        What=/dev/vg_storage/lv_data
        Where=/var/mnt/storage
        Type=xfs
        Options=noatime,nofail

        [Install]
        WantedBy=multi-user.target

    # --- Machine-specific: Wake-on-LAN (nevua-ketana) ---
    # Runs at every boot. Enables WoL on the network interface.

    - name: wol-enable.service
      enabled: true
      contents: |
        [Unit]
        Description=Enable Wake-on-LAN on enp14s0
        ConditionPathExists=/sys/class/net/enp14s0
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/bin/wol-enable.sh

        [Install]
        WantedBy=multi-user.target

    # --- Machine-specific: seed the model files (nevua-ketana) ---
    # A ~30 GB GGUF cannot be embedded in an Ignition config, so the one model
    # this box serves is pulled over the LAN once the volume exists. Needs the
    # second HTTP server on erevrav — see "Serving files over HTTP" in the
    # README.
    # Same marker idiom as the units above: After= plus a ConditionPathExists on
    # the previous step's done marker. Because setup-storage.service is in this
    # boot's transaction, the condition is evaluated after that unit's job ends,
    # so the marker already exists on the boot that builds the volume — and on
    # the boots before it the condition fails cleanly (no "Dependency failed").
    # No Requires= on var-mnt-storage.mount on purpose: on the boot that creates
    # the volume that unit's own condition gate fails early, and a hard
    # dependency would only turn a wait into a failed job. fetch-models.sh waits
    # for the mount with mountpoint(8) instead.
    # TimeoutStartSec: ~30 GB on the LAN outruns the 90s default by minutes.
    # The last ExecStart brings up the llama.cpp server on the *same* boot: the
    # quadlet is gated on /var/lib/fetch-models.done, so its boot-time job was
    # already skipped by then and --no-block just re-queues it (conditions are
    # re-checked, and this time the marker exists).

    - name: fetch-models.service
      enabled: true
      contents: |
        [Unit]
        Description=Fetch llama.cpp model files onto the storage volume (one-shot)
        ConditionPathExists=/var/lib/setup-storage.done
        ConditionPathExists=!/var/lib/fetch-models.done
        After=setup-storage.service var-mnt-storage.mount network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        TimeoutStartSec=infinity
        ExecStart=/usr/local/bin/fetch-models.sh
        ExecStart=/usr/bin/touch /var/lib/fetch-models.done
        ExecStart=/usr/bin/systemctl disable fetch-models.service
        ExecStart=/usr/bin/systemctl --no-block start llama-server.service

        [Install]
        WantedBy=multi-user.target

    # --- llama.cpp server: quadlet + firewall ---
    # The quadlet file (llama-server.container) generates the unit
    # "llama-server.service" (the .container suffix is stripped), and that file
    # owns the unit's enablement through its own [Install] + ConditionPathExists
    # pair — see the comments in llama-server.container. Nothing has to be
    # enabled or disabled from here for a unit a generator writes at boot; this
    # entry only records that the name is taken.
    # `enabled: false` here is a harmless no-op for the generated unit
    # (Ignition's disable is skipped when the unit is not enabled).
    # Because the unit pulls its image on every start, a boot with no registry
    # makes podman fail immediately: the quadlet sets StartLimitIntervalSec=0 and
    # RestartSec=15s so it retries forever instead of landing in failed.

    - name: llama-server.service
      enabled: false

    - name: llama-server-firewall.service
      enabled: true
