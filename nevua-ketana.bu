variant: fcos
version: 1.7.0

# ============================================================
# PASSWD - user accounts (generic)
# ============================================================
passwd:
  users:
    - name: keelan
      groups:
        - wheel
        - sudo
      password_hash: $y$j9T$N75jZXhi8oojIfPr6eqcj0$zl8hpb3Arku2NiaAGc6IV/f18hIQn/G4qj85/b9AztD
      ssh_authorized_keys:
        - ssh-rsa  keelan@erevrav

# ============================================================
# STORAGE - filesystem layout
# ============================================================
storage:

  # --- Directories ---
  directories:
    - path: /etc/ucore-autorebase
      mode: 0755
    - path: /var/mnt/cached-storage
      mode: 0755
    - path: /etc/llama-server
      mode: 0755

  # --- Files ---
  files:
    # Machine-specific: hostname (nevua-ketana)
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: nevua-ketana

    # Machine-specific: bcache lifecycle engine (nevua-ketana)
    # State-aware; runs on every boot via bcache-assemble.service:
    #   1. ASSEMBLE — non-destructively re-registers the existing bcache
    #      set (20TB HDD backing + 1TB NVMe writearound read cache: reads
    #      are cached on the NVMe, writes go straight to the HDD only)
    #   2. INIT — only if assembly fails AND /var/lib/bcache-setup.done is
    #      absent: one-time destructive first-time format (wipefs +
    #      make-bcache + mkfs.xfs), then writes the marker
    # All device references are by stable ID; kernel names are resolved at
    # runtime only for sysfs/size lookups. Mounting is handled by the
    # native var-mnt-cached\x2dstorage.mount unit (FCOS has no /etc/fstab).
    - path: /usr/local/bin/bcache-setup.sh
      mode: 0755
      overwrite: true
      contents:
        local: bcache-setup.sh

    # Machine-specific: WoL helper (nevua-ketana)
    - path: /usr/local/bin/wol-enable.sh
      mode: 0755
      overwrite: true
      contents:
        inline: |
          #!/bin/bash
          set -euo pipefail
          IFACE="enp14s0"
          echo "Enabling Wake-on-LAN on $IFACE..."
          ethtool -s "$IFACE" wol g
          ethtool "$IFACE" | grep -i "wake-on"

    # --- llama.cpp server: config file ---
    - path: /etc/llama-server/llama-server-config.ini
      mode: 0644
      overwrite: true
      contents:
        local: llama-server-config.ini

    # --- llama.cpp server: Podman quadlet ---
    - path: /etc/containers/systemd/llama-server.container
      mode: 0644
      overwrite: true
      contents:
        local: llama-server.container

    # --- llama.cpp server: firewalld rule for port 8001 ---
    # NOTE: plain .service file, so it must live in /etc/systemd/system
    # (systemd's unit search path). /etc/containers/systemd is only scanned
    # by the podman quadlet generator for quadlet files.
    - path: /etc/systemd/system/llama-server-firewall.service
      mode: 0644
      overwrite: true
      contents:
        local: llama-server-firewall.service

# ============================================================
# SYSTEMD UNITS
# ============================================================
systemd:
  units:

    # --- Generic: uCore autorebase chain ---
    # Runs across 2 boots: unsigned rebase → reboot → signed rebase → reboot
    # After both complete, these units are disabled and never run again.

    - name: ucore-unsigned-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to unsigned OCI and reboot
        ConditionPathExists=!/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/ublue-os/ucore-minimal:stable-nvidia
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/unverified
        ExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    - name: ucore-signed-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to signed OCI and reboot
        ConditionPathExists=/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-image-signed:docker://ghcr.io/ublue-os/ucore-minimal:stable-nvidia
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/signed
        ExecStart=/usr/bin/systemctl disable ucore-signed-autorebase.service
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    # --- Generic: package installation ---
    # Waits for signed rebase to complete (avoids race condition).
    # Reboots once after installing, then disables itself.

    - name: install-user-packages.service
      enabled: true
      contents: |
        [Unit]
        Description=Install user packages via rpm-ostree
        ConditionPathExists=/etc/ucore-autorebase/signed
        ConditionPathExists=!/var/lib/install-user-packages.done
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree install neovim tmux tree btop bcache-tools
        ExecStart=/usr/bin/touch /var/lib/install-user-packages.done
        ExecStart=/usr/bin/systemctl disable install-user-packages.service
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    # --- Machine-specific: bcache assembly (nevua-ketana) ---
    # Runs on EVERY boot and never disables itself: it re-registers the
    # bcache superblocks so the volume survives reboots (the old one-shot
    # self-disabling unit left the volume un-assembled on every later
    # boot). Strictly sequenced: After=install-user-packages.service (so
    # bcache-tools is layered first) and Before=local-fs.target (the mount
    # phase). The volume itself is mounted by the native
    # var-mnt-cached\x2dstorage.mount unit below.

    - name: bcache-assemble.service
      enabled: true
      contents: |
        [Unit]
        Description=Assemble bcache (20TB HDD backing + 1TB NVMe writearound read cache)
        Documentation=file:///usr/local/bin/bcache-setup.sh
        ConditionPathExists=/var/lib/install-user-packages.done
        After=install-user-packages.service
        Before=local-fs.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        ExecStart=/usr/local/bin/bcache-setup.sh

        [Install]
        WantedBy=multi-user.target

    # --- Machine-specific: native mount unit (nevua-ketana) ---
    # Replaces the old /etc/fstab entry (runtime fstab mutation is an
    # anti-pattern on immutable FCOS). The unit name is the systemd
    # escaped form of the mount point:
    #   /var/mnt/cached-storage  ->  var-mnt-cached\x2dstorage
    # (slashes become dashes; the literal dash in the directory name is
    # encoded as \x2d; `systemd-escape --path` produces exactly this).
    # nofail + x-systemd.device-timeout=1ms: never block boot waiting for
    # the device to appear (e.g. during first-time provisioning, before
    # the bcache set exists). Requires=/After= the assembly service so the
    # mount only runs once the volume is (re)assembled; Before=llama-
    # server.service holds the app back until the backing filesystem is up.

    - name: var-mnt-cached\x2dstorage.mount
      enabled: true
      contents: |
        [Unit]
        Description=bcache XFS volume at /var/mnt/cached-storage
        Documentation=file:///usr/local/bin/bcache-setup.sh
        Requires=bcache-assemble.service
        After=bcache-assemble.service
        Before=llama-server.service

        [Mount]
        What=/dev/disk/by-uuid/7c1e6a42-9f3d-4b8e-a51c-2d0b8e4f6a37
        Where=/var/mnt/cached-storage
        Type=xfs
        Options=nofail,x-systemd.device-timeout=1ms

        [Install]
        WantedBy=local-fs.target

    # --- Machine-specific: Wake-on-LAN (nevua-ketana) ---
    # Runs at every boot. Enables WoL on the network interface.

    - name: wol-enable.service
      enabled: true
      contents: |
        [Unit]
        Description=Enable Wake-on-LAN on enp14s0
        ConditionPathExists=/sys/class/net/enp14s0
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/bin/wol-enable.sh

        [Install]
        WantedBy=multi-user.target

    # --- llama.cpp server: quadlet + firewall ---
    # The quadlet file (llama-server.container) generates the unit
    # "llama-server.service" (the .container suffix is stripped).
    # It ships DISABLED: the quadlet has no [Install] section, which is
    # the only way to keep a generated quadlet unit from starting at boot
    # (the generator auto-applies [Install]; `systemctl enable`/`disable`
    # do not work on generated units). The model data must be restored to
    # /var/mnt/cached-storage/llama-models first; see the enablement steps
    # in the comments of llama-server.container.
    # `enabled: false` here is a harmless no-op for the generated unit
    # (Ignition's disable is skipped when the unit is not enabled).

    - name: llama-server.service
      enabled: false

    - name: llama-server-firewall.service
      enabled: true
