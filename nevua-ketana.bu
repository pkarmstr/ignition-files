variant: fcos
version: 1.7.0

# ============================================================
# PASSWD - user accounts (generic)
# ============================================================
passwd:
  users:
    - name: keelan
      groups:
        - wheel
        - sudo
      password_hash: $y$j9T$MPeWlpl0kAJe6ioPEItF40$t1hPM7RfNM5p6bNCEhWsntmIVCSW3TI9H0yZQV08sS9
      ssh_authorized_keys:
        - ssh-rsa  keelan@erevrav

# ============================================================
# STORAGE - filesystem layout
# ============================================================
storage:

  # --- Machine-specific: disk devices (nevua-ketana) ---
  # NOTE: No wipe_table_override here. Wipe logic is handled in setup-bcache.service
  # so that existing bcache configurations are preserved on re-provisioning.

  # --- Directories ---
  directories:
    - path: /etc/ucore-autorebase
      mode: 0755
    - path: /var/mnt/cached-storage
      mode: 0755
    - path: /etc/llama-server
      mode: 0755

  # --- Files ---
  files:
    # Machine-specific: hostname (nevua-ketana)
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: nevua-ketana

    # Machine-specific: bcache setup script (nevua-ketana)
    - path: /usr/local/bin/setup-bcache.sh
      mode: 0755
      overwrite: true
      contents:
        local: setup-bcache.sh

    # Machine-specific: bcache reassembly on every boot (nevua-ketana)
    - path: /usr/local/bin/bcache-reassemble.sh
      mode: 0755
      overwrite: true
      contents:
        local: bcache-reassemble.sh

    # NOTE: the fstab entry written by setup-bcache.sh carries
    # x-systemd.after=bcache-reassemble.service, which orders the
    # fstab-generated mount unit after bcache reassembly (no separate
    # drop-in needed).

    # Machine-specific: WoL helper (nevua-ketana)
    - path: /usr/local/bin/wol-enable.sh
      mode: 0755
      overwrite: true
      contents:
        inline: |
          #!/bin/bash
          set -euo pipefail
          IFACE="enp14s0"
          echo "Enabling Wake-on-LAN on $IFACE..."
          ethtool -s "$IFACE" wol g
          ethtool "$IFACE" | grep -i "wake-on"

    # --- llama.cpp server: config file ---
    - path: /etc/llama-server/llama-server-config.ini
      mode: 0644
      overwrite: true
      contents:
        local: llama-server-config.ini

    # --- llama.cpp server: Podman quadlet ---
    - path: /etc/containers/systemd/llama-server.container
      mode: 0644
      overwrite: true
      contents:
        local: llama-server.container

    # --- llama.cpp server: firewalld rule for port 8001 ---
    # NOTE: plain .service file, so it must live in /etc/systemd/system
    # (systemd's unit search path). /etc/containers/systemd is only scanned
    # by the podman quadlet generator for quadlet files.
    - path: /etc/systemd/system/llama-server-firewall.service
      mode: 0644
      overwrite: true
      contents:
        local: llama-server-firewall.service

# ============================================================
# SYSTEMD UNITS
# ============================================================
systemd:
  units:

    # --- Generic: uCore autorebase chain ---
    # Runs across 2 boots: unsigned rebase → reboot → signed rebase → reboot
    # After both complete, these units are disabled and never run again.

    - name: ucore-unsigned-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to unsigned OCI and reboot
        ConditionPathExists=!/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/ublue-os/ucore-minimal:stable-nvidia
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/unverified
        ExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    - name: ucore-signed-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to signed OCI and reboot
        ConditionPathExists=/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-image-signed:docker://ghcr.io/ublue-os/ucore-minimal:stable-nvidia
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/signed
        ExecStart=/usr/bin/systemctl disable ucore-signed-autorebase.service
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    # --- Generic: package installation ---
    # Waits for signed rebase to complete (avoids race condition).
    # Reboots once after installing, then disables itself.

    - name: install-user-packages.service
      enabled: true
      contents: |
        [Unit]
        Description=Install user packages via rpm-ostree
        ConditionPathExists=/etc/ucore-autorebase/signed
        ConditionPathExists=!/var/lib/install-user-packages.done
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree install neovim tmux tree btop bcache-tools
        ExecStart=/usr/bin/touch /var/lib/install-user-packages.done
        ExecStart=/usr/bin/systemctl disable install-user-packages.service
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    # --- Machine-specific: bcache setup (nevua-ketana) ---
    # Runs after packages are installed (needs make-bcache).
    # No reboot — fstab mount takes effect next boot.

    - name: setup-bcache.service
      enabled: true
      contents: |
        [Unit]
        Description=Setup bcache (NVMe read cache for HDD, writearound policy)
        After=install-user-packages.service
        ConditionPathExists=/usr/sbin/make-bcache
        ConditionPathExists=!/var/lib/setup-bcache.done

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        ExecStart=/usr/local/bin/setup-bcache.sh

        [Install]
        WantedBy=multi-user.target

    # --- Machine-specific: Wake-on-LAN (nevua-ketana) ---
    # Runs at every boot. Enables WoL on the network interface.

    - name: wol-enable.service
      enabled: true
      contents: |
        [Unit]
        Description=Enable Wake-on-LAN on enp14s0
        ConditionPathExists=/sys/class/net/enp14s0
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/bin/wol-enable.sh

        [Install]
        WantedBy=multi-user.target

    # --- Machine-specific: bcache reassembly (nevua-ketana) ---
    # Runs at EVERY boot before local filesystems: the kernel does not
    # auto-assemble bcache sets, so without this the fstab mount of
    # /var/mnt/cached-storage fails after the first reboot.

    - name: bcache-reassemble.service
      enabled: true
      contents: |
        [Unit]
        Description=Reassemble bcache devices
        DefaultDependencies=no
        After=local-fs-pre.target systemd-udevd.service
        Before=local-fs.target
        Wants=local-fs-pre.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        ExecStart=/usr/local/bin/bcache-reassemble.sh

        [Install]
        WantedBy=local-fs.target

    # --- llama.cpp server: quadlet + firewall ---
    # The quadlet file (llama-server.container) generates the unit
    # "llama-server.service" (the .container suffix is stripped).
    # It ships DISABLED: the quadlet has no [Install] section, which is
    # the only way to keep a generated quadlet unit from starting at boot
    # (the generator auto-applies [Install]; `systemctl enable`/`disable`
    # do not work on generated units). The model data must be restored to
    # /var/mnt/cached-storage/llama-models first; see the enablement steps
    # in the comments of llama-server.container.
    # `enabled: false` here is a harmless no-op for the generated unit
    # (Ignition's disable is skipped when the unit is not enabled).

    - name: llama-server.service
      enabled: false

    - name: llama-server-firewall.service
      enabled: true
