variant: fcos
version: 1.7.0

# Raise amdgpu's lockup watchdog from the 2 s default to 100 s. At long
# context, one Vulkan compute submit on the Strix Halo iGPU (flash-attn +
# MTP draft graphs, see llama-server-config.ini) legitimately outlives 2 s;
# the kernel then resets the compute ring and llama-server crashes with
# vk::Queue::submit: ErrorDeviceLost (llama.cpp #20515 / #21724). 100 s is
# beyond any real job; a genuine hang is still caught by the 10-min TCO
# watchdog. The parameter is read-only in /sys on current kernels, so the
# cmdline is the only way to set it.
kernel_arguments:
  should_exist:
    - amdgpu.lockup_timeout=100000
    # Disable the IOMMU; the iGPU shares system memory directly.
    - amd_iommu=off
    # No cap on the GPU's visible address space (all of the unified memory).
    - amdgpu.gttsize=-1

passwd:
  users:
    - name: keelan
      groups:
        - wheel
        - sudo
      # Values come from the gitignored secrets.env next to this file;
      # butane.sh substitutes them in before transpiling.
      password_hash: ${USER_PASSWORD_HASH}
      ssh_authorized_keys:
        - ${USER_SSH_PUBLIC_KEY}

storage:
  directories:
    - path: /etc/ucore-autorebase
      mode: 0755
    - path: /var/mnt/storage
      mode: 0755

  # --- Machine-specific: storage disk (hava-amina) ---
  # The second NVMe becomes a whole-disk XFS volume mounted at /var/mnt/storage.
  # Unlike nevua-ketana (whose LVM cache cannot be expressed declaratively and
  # is built by setup-storage.sh on boot 4), the entire layout is done by
  # Ignition on the first boot, before any systemd unit runs: no script, no
  # markers, no reboots.
  # wipe_table erases the old partition table (the disk carried a 1.9 TB
  # partition before the install); wipe_filesystem erases any filesystem
  # signatures it finds. The by-id path is the stable identifier from
  # HARDWARE.md. The two drives are physically identical: a reinstall must
  # target the *other* drive (...1423) or the first boot will wipe the OS.
  # Note: an `options:` key here would be passed to mkfs.xfs, not to mount -
  # the mount options live in var-mnt-storage.mount below.
  disks:
    - device: /dev/disk/by-id/nvme-PCIe_SSD_511250820055001080
      wipe_table: true

  filesystems:
    - device: /dev/disk/by-id/nvme-PCIe_SSD_511250820055001080
      format: xfs
      wipe_filesystem: true

  files:
    # --- Shared: keelan's tmux config ---
    - path: /home/keelan/.tmux.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          set -g mouse on
          set -g extended-keys on
          set -g extended-keys-format csi-u

    # Machine-specific: hostname (hava-amina)
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: hava-amina

    # Machine-specific: WoL helper (hava-amina)
    - path: /usr/local/bin/wol-enable.sh
      mode: 0755
      overwrite: true
      contents:
        inline: |
          #!/bin/bash
          set -euo pipefail
          IFACE="eno1"
          echo "Enabling Wake-on-LAN on $IFACE..."
          ethtool -s "$IFACE" wol g
          ethtool "$IFACE" | grep -i "wake-on"

    # --- Machine-specific: model fetch script (hava-amina) ---
    # /usr/local is a symlink to /var/usrlocal on CoreOS, so this path is
    # writable and survives image upgrades/rebases. Only written here; it is
    # executed once by fetch-models.service (see systemd.units below).
    - path: /usr/local/bin/fetch-models.sh
      mode: 0755
      overwrite: true
      contents:
        local: fetch-models.sh

    # --- Kill switch (hava-amina) ---
    # Same idiom as nevua-ketana: if this file exists at boot 4,
    # fetch-models.sh skips the download and writes its done marker as if it
    # had run, so llama-server.service starts against the existing model
    # tree. Commented out for now while the hava-amina provisioning process is
    # still being refined.
    # Note: unlike nevua-ketana this lock cannot gate the disk wipe — that is
    # done declaratively by Ignition (storage.disks/filesystems above) before
    # any unit runs, and Ignition cannot conditionally skip a storage operation
    # based on a file it writes in the same run. To preserve an existing
    # volume, comment out those two entries instead.
    #
    # - path: /var/lib/provision.lock
    #   mode: 0644
    #   overwrite: true
    #   contents:
    #     inline: 'kill switch: skip model fetch'

    # --- llama.cpp server: Podman quadlet (Vulkan) ---
    # The router's --models-preset INI is deliberately not seeded here: it lives
    # in the model tree and arrives with fetch-models.sh, so nothing under /etc
    # has to point at a volume that does not exist yet on the first boot.
    # Pull-on-boot: the quadlet carries Pull=always, so every start re-resolves
    # the server-vulkan tag and the box runs the newest llama.cpp build.
    - path: /etc/containers/systemd/llama-server.container
      mode: 0644
      overwrite: true
      contents:
        local: llama-server.container

    # --- llama.cpp server: firewalld rule for port 8001 ---
    # NOTE: plain .service file, so it must live in /etc/systemd/system
    # (systemd's unit search path). /etc/containers/systemd is only scanned
    # by the podman quadlet generator for quadlet files.
    - path: /etc/systemd/system/llama-server-firewall.service
      mode: 0644
      overwrite: true
      contents:
        local: llama-server-firewall.service

systemd:
  units:

    # --- Generic: uCore autorebase chain ---
    # Runs across 2 boots: unsigned rebase → reboot → signed rebase → reboot
    # After both complete, these units are disabled and never run again.
    # Plain 'stable' tag: AMD box, no NVIDIA driver needed.

    - name: ucore-unsigned-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to unsigned OCI and reboot
        ConditionPathExists=!/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/ublue-os/ucore-minimal:stable
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/unverified
        ExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    - name: ucore-signed-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to signed OCI and reboot
        ConditionPathExists=/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-image-signed:docker://ghcr.io/ublue-os/ucore-minimal:stable
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/signed
        ExecStart=/usr/bin/systemctl disable ucore-signed-autorebase.service
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    # --- Machine-specific: Wake-on-LAN (hava-amina) ---
    # Runs at every boot. Enables WoL on the network interface.

    - name: wol-enable.service
      enabled: true
      contents: |
        [Unit]
        Description=Enable Wake-on-LAN on eno1
        ConditionPathExists=/sys/class/net/eno1
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/local/bin/wol-enable.sh

        [Install]
        WantedBy=multi-user.target

    # --- Generic: package installation ---
    # Waits for signed rebase to complete (avoids race condition).
    # Reboots once after installing, then disables itself.

    - name: install-user-packages.service
      enabled: true
      contents: |
        [Unit]
        Description=Install user packages via rpm-ostree
        ConditionPathExists=/etc/ucore-autorebase/signed
        ConditionPathExists=!/var/lib/install-user-packages.done
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree install neovim tmux tree btop mt7xxx-firmware rasdaemon
        ExecStart=/usr/bin/touch /var/lib/install-user-packages.done
        ExecStart=/usr/bin/systemctl disable install-user-packages.service
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target

    # --- Machine-specific: mount the storage drive (hava-amina) ---
    # Native systemd mount unit, not /etc/fstab: FCOS ships no fstab and
    # mutating one at runtime is an anti-pattern on immutable images. The
    # unit name is the escaped mount point (systemd-escape --path), i.e.
    # /var/mnt/storage -> var-mnt-storage.mount.
    # Deliberately not with_mount_unit: the unit butane generates carries no
    # nofail and is RequiredBy=local-fs.target, so a dead drive would stall
    # the local-fs phase; a custom unit in systemd.units is the documented
    # way to override it.
    # No condition gate like nevua-ketana's: the disk is formatted by
    # Ignition on the first boot, before any systemd unit starts, so the
    # device exists whenever the mount is attempted. nofail is swallowed by
    # libmount but drops systemd's automatic Before=local-fs.target ordering,
    # so a missing or failed volume can never stall the local-fs phase; with
    # no such ordering the unit belongs to the multi-user phase, which only
    # Wants= it - a failed mount is a failed unit, not a hung boot.
    # enabled: true is genuinely needed: systemd >= v257 no longer injects
    # local-fs.target Wants=<mount>, so nothing pulls a mount unit in on its
    # own. x-systemd.* options are fstab-only and are ignored in a unit's
    # Options= (systemd.mount(5)), so they are absent.

    - name: var-mnt-storage.mount
      enabled: true
      contents: |
        [Unit]
        Description=Storage drive (whole-disk XFS) at /var/mnt/storage

        [Mount]
        What=/dev/disk/by-id/nvme-PCIe_SSD_511250820055001080
        Where=/var/mnt/storage
        Type=xfs
        Options=noatime,nofail

        [Install]
        WantedBy=multi-user.target

    # --- Machine-specific: storage volume ownership (hava-amina) ---
    # mkfs.xfs (run by Ignition) leaves the volume root root:root with no
    # SELinux label: it would mount unlabeled_t, readable but not writable by
    # keelan. Ownership and label are filesystem *content* (the XFS root
    # inode), so writing them once here persists across every later mount and
    # rebase; no unit re-asserts them at boot time.
    # RequiresMountsFor= keeps this unit from touching anything but the real
    # volume: if the mount fails on a boot, this unit fails with it and
    # retries on the next one, and the marker is only written after both
    # commands have succeeded. Runs as unconfined_service_t, which may do
    # both; a mount unit's ExecStartPost would run as fsadm_t, which is not.

    - name: storage-owner.service
      enabled: true
      contents: |
        [Unit]
        Description=Set owner and SELinux label on the /var/mnt/storage volume
        ConditionPathExists=!/var/lib/storage-owner.done
        After=var-mnt-storage.mount
        RequiresMountsFor=/var/mnt/storage

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        ExecStart=/usr/bin/chown keelan:keelan /var/mnt/storage
        ExecStart=/usr/sbin/restorecon -F /var/mnt/storage
        ExecStart=/usr/bin/touch /var/lib/storage-owner.done
        ExecStart=/usr/bin/systemctl disable storage-owner.service

        [Install]
        WantedBy=multi-user.target

    # --- Machine-specific: seed the model files (hava-amina) ---
    # A 24 GB GGUF cannot be embedded in an Ignition config, so the one model
    # this box serves is pulled over the LAN once the rebase chain is done.
    # Needs the model HTTP server on erevrav — see "Serving files over HTTP"
    # (the 33334 server) in the README.
    # Gated on install-user-packages' done marker, the end of the 3-boot rebase
    # chain: the model fetch is the first thing on boot 4. No mount race here
    # (unlike nevua-ketana's same-boot volume creation): Ignition formats the
    # disk before any unit runs, so var-mnt-storage.mount is a normal member of
    # every boot's transaction and After= orders this job after it for real.
    # TimeoutStartSec: 24 GB on the LAN outruns the 90s default by minutes.
    # The last ExecStart brings up the llama.cpp server on the *same* boot: the
    # quadlet is gated on /var/lib/fetch-models.done, so its boot-time job was
    # already skipped by then and --no-block just re-queues it (conditions are
    # re-checked, and this time the marker exists).

    - name: fetch-models.service
      enabled: true
      contents: |
        [Unit]
        Description=Fetch llama.cpp model files onto the storage volume (one-shot)
        ConditionPathExists=/var/lib/install-user-packages.done
        ConditionPathExists=!/var/lib/fetch-models.done
        After=install-user-packages.service var-mnt-storage.mount network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        StandardOutput=journal+console
        TimeoutStartSec=infinity
        ExecStart=/usr/local/bin/fetch-models.sh
        ExecStart=/usr/bin/touch /var/lib/fetch-models.done
        ExecStart=/usr/bin/systemctl disable fetch-models.service
        ExecStart=/usr/bin/systemctl --no-block start llama-server.service

        [Install]
        WantedBy=multi-user.target

    # --- llama.cpp server: quadlet + firewall (hava-amina) ---
    # The quadlet file (llama-server.container) generates the unit
    # "llama-server.service" (the .container suffix is stripped), and that file
    # owns the unit's enablement through its own [Install] + ConditionPathExists
    # pair — see the comments in llama-server.container. Nothing has to be
    # enabled or disabled from here for a unit a generator writes at boot; this
    # entry only records that the name is taken.
    # `enabled: false` here is a harmless no-op for the generated unit
    # (Ignition's disable is skipped when the unit is not enabled).
    # Because the unit pulls its image on every start, a boot with no registry
    # makes podman fail immediately: the quadlet sets StartLimitIntervalSec=0 and
    # RestartSec=15s so it retries forever instead of landing in failed.

    - name: llama-server.service
      enabled: false

    - name: llama-server-firewall.service
      enabled: true
